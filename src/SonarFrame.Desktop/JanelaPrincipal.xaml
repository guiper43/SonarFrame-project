<Window x:Class="SonarFrame.Desktop.JanelaPrincipal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="sonarFrame" FontSize="16" Width="1180" Height="830" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterScreen" PreviewKeyDown="TeclaJanela" Closing="FechandoJanela">
 <DockPanel x:Name="Estrutura">
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="_Projeto"><MenuItem Header="_Novo projeto" Click="NovoProjeto"/><MenuItem Header="_Abrir projeto…" Click="AbrirProjeto"/><MenuItem Header="_Salvar" InputGestureText="Ctrl+S" Click="SalvarProjeto"/><MenuItem Header="Salvar _como…" Click="SalvarComo"/><Separator/><MenuItem Header="Tela _inicial" Click="IrParaInicio"/><MenuItem Header="Sai_r" Click="Sair"/></MenuItem>
   <MenuItem Header="A_juda"><MenuItem Header="_Atalhos de teclado" InputGestureText="F1" Click="Ajuda"/><MenuItem Header="_Sobre o sonarFrame" Click="Sobre"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="Gray" Padding="14,8">
   <TextBlock x:Name="Situacao" Text="Bem-vindo ao sonarFrame." AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid Margin="24,12">
    <StackPanel x:Name="TelaInicial" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Center">
     <TextBlock Text="sonarFrame" FontSize="42" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <TextBlock Text="Seu vídeo, no seu ritmo." FontSize="25" Margin="0,0,0,16"/>
     <TextBlock Text="Crie um projeto, importe suas mídias e organize a composição pelo teclado. Reprodução e exportação chegarão nas próximas etapas." Margin="0,0,0,24"/>
     <Button x:Name="BotaoNovo" Content="_Novo projeto" Click="NovoProjeto" HorizontalContentAlignment="Left"/>
     <Button Content="_Meus projetos" Click="MeusProjetos" HorizontalContentAlignment="Left"/>
     <Button Content="_Abrir projeto existente…" Click="AbrirProjeto" HorizontalContentAlignment="Left"/>
     <Button Content="_Configurações" Click="Configuracoes" HorizontalContentAlignment="Left"/>
     <Separator Margin="0,16"/>
     <Button Content="Explorar projeto de _demonstração" Click="Demonstracao" HorizontalContentAlignment="Left"/>
     <TextBlock Text="A demonstração contém itens fictícios para experimentar listas, propriedades e organização. Nenhum arquivo pessoal será importado." Margin="0,8,0,16"/>
     <TextBlock Text="Tab: próximo controle · Shift+Tab: anterior · F1: ajuda"/>
    </StackPanel>
    <StackPanel x:Name="Editor" Visibility="Collapsed">
     <TextBlock x:Name="TituloProjeto" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Alt+1 a Alt+5: ir para uma região · F6: próxima região · F1: atalhos" Margin="0,6,0,12"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox x:Name="RegiaoBiblioteca" Header="1 · Biblioteca de mídias" AutomationProperties.Name="Biblioteca de mídias, região 1">
       <StackPanel><Button x:Name="BotaoAdicionar" Content="_Adicionar…" Click="AdicionarMidia" AutomationProperties.HelpText="Abre as guias de tipos de mídia"/>
        <ListBox x:Name="Biblioteca" Height="135" SelectionMode="Extended" GotKeyboardFocus="BibliotecaRecebeuFoco" AutomationProperties.Name="Mídias importadas" AutomationProperties.HelpText="Use Control e Shift com as setas ou espaço para selecionar vários arquivos." DisplayMemberPath="Rotulo" SelectionChanged="MidiaSelecionada"/>
        <TextBlock x:Name="BibliotecaVazia" Text="Sua biblioteca está vazia." Margin="0,6"/>
        <Button x:Name="BotaoInserir" Content="Adicionar à linha do tempo" Click="Inserir" IsEnabled="False"/>
        <Button Content="Inserir antes do clipe selecionado" Click="InserirAntes"/>
        <Button x:Name="BotaoAdicionarCamada" Content="Adicionar como camada…" Click="AdicionarCamadaIndependente" IsEnabled="False"/>
        <Button Content="Localizar arquivo…" Click="LocalizarMidia"/>
       </StackPanel>
      </GroupBox>
      <GroupBox x:Name="RegiaoPropriedades" Grid.Column="1" Header="2 · Propriedades do elemento">
       <StackPanel><TextBox x:Name="Propriedades" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" MinHeight="100" AutomationProperties.Name="Propriedades do elemento selecionado" Text="Selecione um conteúdo na biblioteca ou na linha do tempo."/>
        <TextBlock Text="Selecionar um conteúdo não inicia a reprodução." Margin="0,8"/>
        <Button x:Name="BotaoVolume" Content="Ajustar volume…" Click="AlterarVolume" IsEnabled="False"/>
        <Button x:Name="BotaoEditarCamada" Content="Editar intervalo da camada…" Click="EditarCamada" IsEnabled="False"/>
        <Button x:Name="BotaoRemoverCamada" Content="Remover camada" Click="ExcluirCamada" IsEnabled="False"/>
       </StackPanel>
      </GroupBox>
     </Grid>
     <GroupBox x:Name="RegiaoLinhaDoTempo" Header="3 · Linha do tempo">
      <StackPanel>
       <Button x:Name="NavegadorTemporal" Content="Posição: 00:00:00.000" HorizontalContentAlignment="Left" PreviewKeyDown="TeclaNavegacaoTemporal" Click="LerPosicao" AutomationProperties.Name="Navegação temporal" AutomationProperties.HelpText="Setas: um quadro. Control e setas: um segundo. Page Up ou Down: dez segundos. Shift seleciona. Home e End: extremos."/>
       <TextBlock x:Name="ResumoSelecao" Text="Nenhum intervalo selecionado." Margin="0,4"/>
       <WrapPanel><Button x:Name="BotaoDividir" Content="Dividir no cursor" Click="DividirNoCursor" AutomationProperties.HelpText="Control B" IsEnabled="False"/><Button x:Name="BotaoExcluirSelecao" Content="Excluir intervalo selecionado" Click="ExcluirIntervaloSelecionado" IsEnabled="False"/></WrapPanel>
       <ListBox x:Name="LinhaDoTempo" Height="115" DisplayMemberPath="Rotulo" GotKeyboardFocus="LinhaDoTempoRecebeuFoco" AutomationProperties.Name="Conteúdos da composição" SelectionChanged="ConteudoSelecionado">
        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Mover para o início" Click="MoverParaInicio"/><MenuItem Header="Mover para antes" Click="MoverAntes"/><MenuItem Header="Mover para depois" Click="MoverDepois"/><MenuItem Header="Mover para o fim" Click="MoverParaFim"/></ContextMenu></ListBox.ContextMenu>
       </ListBox>
       <TextBlock x:Name="LinhaDoTempoVazia" Text="A composição está vazia. Adicione um item da biblioteca." Margin="0,6"/>
       <WrapPanel><Button Content="Mover para antes" Click="MoverAntes"/><Button Content="Mover para depois" Click="MoverDepois"/><Button x:Name="BotaoDesfazer" Content="Desfazer" Click="Desfazer"/><Button x:Name="BotaoRefazer" Content="Refazer" Click="Refazer"/></WrapPanel>
      </StackPanel>
     </GroupBox>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox x:Name="RegiaoPrevia" Header="4 · Prévia e reprodução"><StackPanel>
       <TextBlock Text="A reprodução de áudio e vídeo ainda não está disponível." Margin="0,0,0,8"/>
       <Button x:Name="BotaoPrevia" Content="Sobre a prévia" Click="InformacoesPrevia"/>
      </StackPanel></GroupBox>
      <GroupBox x:Name="RegiaoComandos" Grid.Column="1" Header="5 · Comandos do projeto"><WrapPanel>
       <Button x:Name="BotaoSalvar" Content="Salvar projeto" Click="SalvarProjeto" AutomationProperties.HelpText="Control S"/>
       <Button Content="Sobre a exportação" Click="InformacoesExportacao"/>
       <Button Content="Tela inicial" Click="IrParaInicio"/>
      </WrapPanel></GroupBox>
     </Grid>
     <Expander Header="Mensagens recentes" Margin="6" IsExpanded="False"><ListBox x:Name="Mensagens" Height="100" AutomationProperties.Name="Mensagens recentes"/></Expander>
    </StackPanel>
   </Grid>
  </ScrollViewer>
 </DockPanel>
</Window>

