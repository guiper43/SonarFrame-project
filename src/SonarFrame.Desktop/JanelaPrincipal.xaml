<Window x:Class="SonarFrame.Desktop.JanelaPrincipal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SonarFrame.Desktop"
 Title="sonarFrame" FontSize="16" Width="1180" Height="830" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterScreen" PreviewKeyDown="TeclaJanela" Closing="FechandoJanela">
 <DockPanel x:Name="Estrutura">
  <local:MenuComAberturaExplicita x:Name="MenuPrincipal" DockPanel.Dock="Top" Visibility="{Binding Visibility, ElementName=Editor}" AutomationProperties.HelpText="Enter ou Espaço abre e recolhe o menu. Esquerda e Direita trocam de menu sem abrir. Escape fecha.">
   <MenuItem Header="_Projeto"><MenuItem Header="_Novo projeto" Click="NovoProjeto"/><MenuItem Header="_Abrir projeto…" Click="AbrirProjeto"/><MenuItem Header="_Salvar" InputGestureText="Ctrl+S" Click="SalvarProjeto"/><MenuItem Header="Salvar _como…" Click="SalvarComo"/><Separator/><MenuItem Header="Tela _inicial" Click="IrParaInicio"/><MenuItem Header="Sai_r" Click="Sair"/></MenuItem>
   <MenuItem Header="A_juda"><MenuItem Header="_Atalhos de teclado" InputGestureText="F1" Click="Ajuda"/><MenuItem Header="_Sobre o sonarFrame" Click="Sobre"/></MenuItem>
  </local:MenuComAberturaExplicita>
  <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="Gray" Padding="14,8">
   <TextBlock x:Name="Situacao" Text="Bem-vindo ao sonarFrame." AutomationProperties.LiveSetting="Polite"/>
  </Border>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <Grid Margin="24,12">
    <StackPanel x:Name="TelaInicial" MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Center" PreviewKeyDown="TeclaTelaInicial">
     <TextBlock Text="sonarFrame" FontSize="42" FontWeight="SemiBold" Margin="0,18,0,8"/>
     <TextBlock Text="Seu vídeo, no seu ritmo." FontSize="25" Margin="0,0,0,16"/>
     <TextBlock Text="Crie um projeto, importe e confira suas mídias e organize a composição pelo teclado. Reproduza a montagem com suas camadas de áudio, vídeo e fotos. Exportação chegará em outra etapa." Margin="0,0,0,24"/>
     <Button x:Name="BotaoNovo" Content="_Novo projeto" Click="NovoProjeto" HorizontalContentAlignment="Left"/>
     <Button Content="_Meus projetos" Click="MeusProjetos" HorizontalContentAlignment="Left"/>
     <Button Content="_Abrir projeto existente…" Click="AbrirProjeto" HorizontalContentAlignment="Left"/>
     <Button Content="_Configurações" Click="Configuracoes" HorizontalContentAlignment="Left"/>
     <Separator Margin="0,16"/>
     <Button x:Name="BotaoDemonstracao" Content="Explorar projeto de _demonstração" Click="Demonstracao" HorizontalContentAlignment="Left"/>
     <TextBlock Text="A demonstração contém itens fictícios para experimentar listas, propriedades e organização. Nenhum arquivo pessoal será importado." Margin="0,8,0,16"/>
     <Button x:Name="BotaoAjudaInicial" Content="A_juda" Click="AlternarAjudaInicial" HorizontalContentAlignment="Left" AutomationProperties.Name="Ajuda, opções recolhidas" AutomationProperties.HelpText="Enter ou Espaço expande ou recolhe as opções. Cima e Baixo navegam sem expandir."/>
     <StackPanel x:Name="OpcoesAjudaInicial" Visibility="Collapsed" Margin="24,0,0,0">
      <Button x:Name="BotaoAtalhosInicial" Content="_Atalhos de teclado" Click="Ajuda" HorizontalContentAlignment="Left"/>
      <Button x:Name="BotaoSobreInicial" Content="_Sobre o sonarFrame" Click="Sobre" HorizontalContentAlignment="Left"/>
     </StackPanel>
     <TextBlock Text="Cima/Baixo ou Tab/Shift+Tab: navegar · Enter/Espaço: ativar · F1: ajuda"/>
    </StackPanel>
    <StackPanel x:Name="Editor" Visibility="Collapsed" PreviewKeyDown="TeclaAreaEditor">
     <Button x:Name="BotaoVoltarInicio" Content="Voltar para a tela inicial" Click="IrParaInicio" HorizontalAlignment="Left" AutomationProperties.HelpText="Fecha o projeto e volta ao início. Se houver alterações não salvas, permite salvar ou cancelar a saída."/>
     <TextBlock x:Name="TituloProjeto" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Tab/Shift+Tab: acessar ações · Cima/Baixo: selecionar arquivos · Enter: abrir prévia · F6: trocar de área · F1: atalhos" Margin="0,6,0,12"/>
     <GroupBox Header="Biblioteca de mídias e prévia">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox x:Name="RegiaoBiblioteca" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained" Header="Arquivos e ações (Alt+1)" AutomationProperties.Name="Biblioteca de mídias, região 1">
       <StackPanel><Button x:Name="BotaoAdicionar" Content="_Adicionar…" Click="AdicionarMidia" AutomationProperties.HelpText="Abre as guias de tipos de mídia"/>
        <ListBox x:Name="Biblioteca" Height="135" SelectionMode="Extended" GotKeyboardFocus="BibliotecaRecebeuFoco" AutomationProperties.Name="Mídias importadas" AutomationProperties.HelpText="Cima/Baixo seleciona arquivos. Enter abre a prévia. Tab acessa as ações do arquivo selecionado. Delete remove da biblioteca sem apagar o arquivo original. Control e Shift permitem selecionar vários arquivos." DisplayMemberPath="Rotulo" SelectionChanged="MidiaSelecionada"/>
        <TextBlock x:Name="BibliotecaVazia" Text="Sua biblioteca está vazia." Margin="0,6"/>
        <Button x:Name="BotaoAbrirPrevia" Content="Abrir prévia da mídia selecionada" Click="AbrirPreviaSelecionada" IsEnabled="False" AutomationProperties.HelpText="Selecione uma única mídia. Não adiciona à composição."/>
        <Button x:Name="BotaoInserir" Content="Adicionar à linha do tempo" Click="Inserir" IsEnabled="False"/>
        <Button Content="Inserir antes do clipe selecionado" Click="InserirAntes"/>
        <Button x:Name="BotaoAdicionarCamada" Content="Adicionar como camada…" Click="AdicionarCamadaIndependente" IsEnabled="False"/>
        <Button x:Name="BotaoLocalizarMidia" Content="Localizar arquivo…" Click="LocalizarMidia"/>
        <Button x:Name="BotaoRemoverMidia" Content="Remover da biblioteca" Click="RemoverDaBiblioteca" IsEnabled="False" AutomationProperties.HelpText="Delete na lista. Preserva os arquivos originais. Control Z desfaz."/>
       </StackPanel>
      </GroupBox>
      <GroupBox x:Name="RegiaoPrevia" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained" Grid.Column="1" Header="Prévia da biblioteca (Alt+4)"><StackPanel>
       <TextBlock x:Name="TituloPrevia" Text="Nenhuma prévia aberta. Selecione uma mídia na biblioteca e acione Abrir prévia."/>
       <ContentControl x:Name="SuperficiePrevia" Height="180" Focusable="False" IsTabStop="False" Visibility="Collapsed"/>
       <Image x:Name="QuadroDaComposicao" Height="180" Stretch="Uniform" Focusable="False" Visibility="Collapsed" AutomationProperties.Name="Quadro da composição"/>

       <TextBlock x:Name="PosicaoPrevia" Text="" AutomationProperties.LiveSetting="Off"/>
       <WrapPanel>
        <Button x:Name="BotaoReproduzirPrevia" Content="Reproduzir" Click="AlternarPrevia" IsEnabled="False"/>
        <Button x:Name="BotaoPararPrevia" Content="Parar" Click="PararPrevia" IsEnabled="False"/>
        <Button x:Name="BotaoCancelarPrevia" Content="Cancelar abertura da prévia" Click="CancelarPrevia" IsEnabled="False"/>
       </WrapPanel>
       <Button x:Name="BotaoPrevia" Content="Consultar prévia" Click="ConsultarPrevia" AutomationProperties.Name="Consultar estado e posição da prévia"/>
       <Label Content="Posição na mídia, em segundos" Target="{Binding ElementName=DestinoPrevia}"/>
       <TextBox x:Name="DestinoPrevia" Text="0" IsEnabled="False" AutomationProperties.Name="Posição na mídia, em segundos"/>
       <Button x:Name="BotaoBuscarPrevia" Content="Buscar e pausar" Click="BuscarPrevia" IsEnabled="False"/>
       <TextBlock Text="Prévia do arquivo original ou da composição com camadas. Consultar prévia informa também as camadas ativas."/>
      </StackPanel></GroupBox>
     </Grid>
     </GroupBox>
      <GroupBox x:Name="RegiaoPropriedades" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained" Header="2 · Propriedades do elemento">
       <StackPanel><TextBox x:Name="Propriedades" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" MinHeight="100" AutomationProperties.Name="Propriedades do elemento selecionado" Text="Selecione um conteúdo na biblioteca ou na linha do tempo."/>
        <TextBlock Text="Selecionar um conteúdo não inicia a reprodução." Margin="0,8"/>
        <Button x:Name="BotaoVolume" Content="Ajustar volume…" Click="AlterarVolume" IsEnabled="False"/>
        <Button x:Name="BotaoEditarCamada" Content="Editar intervalo da camada…" Click="EditarCamada" IsEnabled="False"/>
        <Button x:Name="BotaoRemoverCamada" Content="Remover camada" Click="ExcluirCamada" IsEnabled="False"/>
       </StackPanel>
      </GroupBox>
     <GroupBox x:Name="RegiaoLinhaDoTempo" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained" Header="3 · Linha do tempo">
      <StackPanel>
       <Button x:Name="NavegadorTemporal" Content="Posição: 00:00:00.000" HorizontalContentAlignment="Left" PreviewKeyDown="TeclaNavegacaoTemporal" Click="LerPosicao" AutomationProperties.Name="Navegação temporal" AutomationProperties.HelpText="Esquerda/Direita: um quadro. Control e Esquerda/Direita: um segundo. Page Up ou Down: dez segundos. Shift seleciona. Home e End: extremos. Enter vai ao início do elemento selecionado. Espaço reproduz ou pausa a composição."/>
       <TextBlock x:Name="ResumoSelecao" Text="Nenhum intervalo selecionado." Margin="0,4"/>

       <ListBox x:Name="LinhaDoTempo" Height="115" DisplayMemberPath="Rotulo" GotKeyboardFocus="LinhaDoTempoRecebeuFoco" AutomationProperties.Name="Conteúdos da composição em ordem de início no vídeo" AutomationProperties.HelpText="Cima/Baixo seleciona elementos sem sair da lista. Enter vai ao início do elemento selecionado. Espaço reproduz ou pausa a composição. Tab acessa as ações. Esquerda/Direita move o tempo. Home vai ao início e End ao fim do vídeo." SelectionChanged="ConteudoSelecionado">
        <ListBox.ContextMenu><ContextMenu><MenuItem Header="Mover para o início" Click="MoverParaInicio"/><MenuItem Header="Mover para antes" Click="MoverAntes"/><MenuItem Header="Mover para depois" Click="MoverDepois"/><MenuItem Header="Mover para o fim" Click="MoverParaFim"/></ContextMenu></ListBox.ContextMenu>
       </ListBox>
       <WrapPanel>
        <Button x:Name="BotaoPararComposicao" Content="Parar composição" Click="PararComposicao" IsEnabled="False"/>
        <Button x:Name="BotaoReproduzirSelecao" Content="Reproduzir intervalo selecionado" Click="ReproduzirSelecaoComposicao" IsEnabled="False"/>
        <Button x:Name="BotaoCancelarComposicao" Content="Cancelar preparação ou busca" Click="CancelarPreparacaoComposicao" IsEnabled="False"/>
        <Button x:Name="BotaoRemoverComposicao" Content="Remover elemento da composição" Click="RemoverDaComposicao" IsEnabled="False" AutomationProperties.HelpText="Delete na lista. Fecha o intervalo do clipe e ajusta as camadas; preserva a mídia na biblioteca. Control Z desfaz."/>
       </WrapPanel>
       <WrapPanel><Button x:Name="BotaoDividir" Content="Dividir no cursor" Click="DividirNoCursor" AutomationProperties.HelpText="Control B" IsEnabled="False"/><Button x:Name="BotaoExcluirSelecao" Content="Excluir intervalo selecionado" Click="ExcluirIntervaloSelecionado" IsEnabled="False"/></WrapPanel>
       <TextBlock x:Name="LinhaDoTempoVazia" Text="A composição está vazia. Adicione um item da biblioteca." Margin="0,6"/>
       <WrapPanel><Button x:Name="BotaoMoverAntes" Content="Mover para antes" Click="MoverAntes"/><Button x:Name="BotaoMoverDepois" Content="Mover para depois" Click="MoverDepois"/><Button x:Name="BotaoDesfazer" Content="Desfazer" Click="Desfazer"/><Button x:Name="BotaoRefazer" Content="Refazer" Click="Refazer"/></WrapPanel>
      </StackPanel>
     </GroupBox>
     <GroupBox x:Name="RegiaoComandos" KeyboardNavigation.TabNavigation="Continue" KeyboardNavigation.DirectionalNavigation="Contained" Header="5 · Comandos do projeto"><WrapPanel>
       <Button x:Name="BotaoSalvar" Content="Salvar projeto" Click="SalvarProjeto" AutomationProperties.HelpText="Control S"/>
       <Button Content="Sobre a exportação" Click="InformacoesExportacao"/>
      </WrapPanel></GroupBox>
     <Expander Header="Mensagens recentes" Margin="6" IsExpanded="False"><ListBox x:Name="Mensagens" Height="100" AutomationProperties.Name="Mensagens recentes"/></Expander>
    </StackPanel>
   </Grid>
  </ScrollViewer>
 </DockPanel>
</Window>

